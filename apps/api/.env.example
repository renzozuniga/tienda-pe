# Coincide con docker-compose.yml de la raíz
DATABASE_URL="postgresql://tienda:tienda@localhost:5433/tienda?schema=public"
# En Render no se define: la API usa PORT, que pone la plataforma.
API_PORT=3001
API_HOST=127.0.0.1
# Orígenes permitidos por CORS, separados por comas (la web en desarrollo)
WEB_ORIGIN=http://localhost:5173
